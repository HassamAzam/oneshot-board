# Where the board is deployed (no trailing slash) and the shared ingest secret.
BOARD_URL=https://your-app.vercel.app
INGEST_TOKEN=paste-the-same-value-you-put-on-vercel

# Optional. Defaults shown.
# ONESHOT_HOME=/Users/you/Documents/oneshot
# BOARD_STATE_DIR=/Users/you/.oneshot-board
# SCAN_INTERVAL_MS=5000
# FLUSH_INTERVAL_MS=60000
# MAX_BATCH_BYTES=1500000
# MAX_TOOL_OUTPUT_BYTES=512000
# ABANDON_AFTER_MS=900000
# DRY_RUN=0
