# Supabase -> Project Settings -> Database -> Connection string -> "Transaction" pooler (port 6543), URI form, with your password filled in.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Shared secret the collector presents. Generate with: openssl rand -hex 32
INGEST_TOKEN=

# Signs the login session cookie. Generate with: openssl rand -hex 32. Leave empty to run the board open (local dev only).
SESSION_SECRET=
